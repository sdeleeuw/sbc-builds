FROM debian:13

# apply latest security patches
RUN apt-get update \
 && apt-get -y upgrade \
 && apt-get -y full-upgrade \
 && apt-get -y autoremove \
 && apt-get -y clean

# basic tools
RUN apt-get -y install git sudo vim wget

# add non priviledged user for building
RUN useradd --uid 1000 --comment "Build" --shell /bin/bash --create-home build \
 && echo "build ALL=(ALL) NOPASSWD: ALL" | tee /etc/sudoers.d/build-nopasswd

# basic build environment
RUN apt-get -y install build-essential cmake pkg-config

# other dependencies
RUN apt-get -y --no-install-recommends install \
  libbrotli-dev \
  libcairo2-dev \
  libdbus-1-dev \
  libdecor-0-dev \
  libegl-dev \
  libgl-dev \
  libglu1-mesa-dev \
  libgtk-3-dev \
  libjpeg62-turbo-dev \
  libpango1.0-dev \
  libpng-dev \
  libssl-dev \
  libwayland-dev \
  libwebp-dev \
  libxkbcommon-dev \
  wayland-protocols \
  zlib1g-dev

USER build
WORKDIR /build
