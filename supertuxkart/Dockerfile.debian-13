FROM debian:13

# apply latest security patches
RUN apt-get update \
 && apt-get -y upgrade \
 && apt-get -y full-upgrade \
 && apt-get -y autoremove \
 && apt-get -y clean

# basic tools
RUN apt-get -y install git sudo vim wget

# add non priviledged user for building
RUN useradd --uid 1000 --comment "Build" --shell /bin/bash --create-home build \
 && echo "build ALL=(ALL) NOPASSWD: ALL" | tee /etc/sudoers.d/build-nopasswd

# basic build environment
RUN apt-get -y install build-essential cmake pkgconf

# SDL2 library
RUN apt-get -y install libsdl2-dev

# Vulkan renderer: shaderc (shader compiler) and astcenc (ASTC texture compression)
RUN apt-get -y install \
  libastcenc-dev \
  libshaderc-dev

# other dependencies
RUN apt-get -y install \
  libbluetooth-dev \
  libcurl4-openssl-dev \
  libfreetype-dev \
  libharfbuzz-dev \
  libjpeg62-turbo-dev \
  libmcpp-dev \
  libogg-dev \
  libopenal-dev \
  libpng-dev \
  libsquish-dev \
  libssl-dev \
  libvorbis-dev \
  zlib1g-dev

USER build
WORKDIR /build
